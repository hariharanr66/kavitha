<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Kavitha Beauty Products – Dashboard</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <style>
    /* ── Reset & Variables ─────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --rose:      #e8a0aa;
      --rose-deep: #c9626f;
      --blush:     #f5d6da;
      --petal:     #fdf0f2;
      --cream:     #fdf6f0;
      --beige:     #f0e8df;
      --taupe:     #c4a882;
      --brown:     #7a5c44;
      --text:      #3d2b1f;
      --muted:     #9e8070;
      --white:     #ffffff;
      --green:     #7dc9a0;
      --amber:     #f4b96e;
      --red:       #e07070;

      --shadow-sm: 0 2px 10px rgba(200,100,110,.10);
      --shadow:    0 6px 28px rgba(200,100,110,.14);
      --shadow-lg: 0 14px 48px rgba(200,100,110,.18);
      --radius:    18px;
      --radius-sm: 10px;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--cream);
      color: var(--text);
      min-height: 100vh;
      font-size: 15px;
      line-height: 1.6;
    }

    /* ── Scrollbar ─────────────────────────────────────────── */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: var(--petal); }
    ::-webkit-scrollbar-thumb { background: var(--rose); border-radius: 99px; }

    /* ── Header ────────────────────────────────────────────── */
    header {
      background: linear-gradient(135deg, #fff0f2 0%, #fde8ec 60%, #f5d6da 100%);
      border-bottom: 1.5px solid var(--blush);
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 20px rgba(200,100,110,.10);
    }

    .header-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 70px;
      gap: 16px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-shrink: 0;
    }

    .brand-logo {
      width: 46px; height: 46px;
      background: linear-gradient(135deg, var(--rose-deep), var(--rose));
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 22px;
      box-shadow: 0 4px 14px rgba(200,98,111,.30);
      flex-shrink: 0;
    }

    .brand-text h1 {
      font-family: 'Playfair Display', serif;
      font-size: 1.22rem;
      font-weight: 700;
      color: var(--rose-deep);
      letter-spacing: .01em;
      line-height: 1.2;
    }

    .brand-text p {
      font-size: .75rem;
      color: var(--muted);
      font-weight: 400;
      letter-spacing: .04em;
    }

    nav { display: flex; gap: 4px; }

    nav a {
      text-decoration: none;
      font-size: .88rem;
      font-weight: 500;
      color: var(--muted);
      padding: 7px 15px;
      border-radius: 99px;
      transition: all .22s ease;
      white-space: nowrap;
    }

    nav a:hover, nav a.active {
      background: var(--rose-deep);
      color: var(--white);
      box-shadow: 0 3px 12px rgba(200,98,111,.30);
    }

    .hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 6px;
      border: none;
      background: none;
    }

    .hamburger span {
      width: 22px; height: 2px;
      background: var(--rose-deep);
      border-radius: 99px;
      transition: all .3s;
    }

    /* Mobile nav */
    .mobile-nav {
      display: none;
      flex-direction: column;
      background: #fff8f9;
      border-top: 1px solid var(--blush);
      padding: 10px 20px 16px;
      gap: 4px;
    }

    .mobile-nav a {
      text-decoration: none;
      font-size: .92rem;
      font-weight: 500;
      color: var(--muted);
      padding: 10px 14px;
      border-radius: var(--radius-sm);
      transition: all .2s;
    }

    .mobile-nav a:hover { background: var(--blush); color: var(--rose-deep); }
    .mobile-nav.open { display: flex; }

    /* ── Layout ────────────────────────────────────────────── */
    main {
      max-width: 1280px;
      margin: 0 auto;
      padding: 36px 28px 60px;
      display: flex;
      flex-direction: column;
      gap: 42px;
    }

    .section-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--brown);
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .section-title::after {
      content: '';
      flex: 1;
      height: 1.5px;
      background: linear-gradient(90deg, var(--blush), transparent);
      border-radius: 99px;
    }

    /* ── Welcome Banner ────────────────────────────────────── */
    .welcome-banner {
      background: linear-gradient(135deg, var(--rose-deep) 0%, #d87080 50%, var(--rose) 100%);
      border-radius: var(--radius);
      padding: 30px 36px;
      color: white;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      box-shadow: var(--shadow-lg);
      overflow: hidden;
      position: relative;
    }

    .welcome-banner::before {
      content: '';
      position: absolute;
      top: -40px; right: -40px;
      width: 200px; height: 200px;
      background: rgba(255,255,255,.08);
      border-radius: 50%;
    }

    .welcome-banner::after {
      content: '';
      position: absolute;
      bottom: -60px; right: 100px;
      width: 160px; height: 160px;
      background: rgba(255,255,255,.06);
      border-radius: 50%;
    }

    .welcome-text h2 {
      font-family: 'Playfair Display', serif;
      font-size: 1.55rem;
      font-weight: 700;
      line-height: 1.3;
      margin-bottom: 6px;
    }

    .welcome-text p {
      font-size: .9rem;
      opacity: .85;
      font-weight: 300;
    }

    .welcome-emoji { font-size: 3rem; flex-shrink: 0; }

    /* ── Summary Cards ─────────────────────────────────────── */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .card {
      background: var(--white);
      border-radius: var(--radius);
      padding: 24px 22px;
      box-shadow: var(--shadow-sm);
      border: 1.5px solid var(--blush);
      transition: transform .25s ease, box-shadow .25s ease;
      position: relative;
      overflow: hidden;
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow);
    }

    .card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 4px;
      border-radius: var(--radius) var(--radius) 0 0;
    }

    .card-1::before { background: linear-gradient(90deg, var(--rose-deep), var(--rose)); }
    .card-2::before { background: linear-gradient(90deg, var(--taupe), var(--beige)); }
    .card-3::before { background: linear-gradient(90deg, #7dc9a0, #a8e0c4); }
    .card-4::before { background: linear-gradient(90deg, var(--amber), #f8d5a0); }

    .card-icon {
      font-size: 1.9rem;
      margin-bottom: 12px;
      display: block;
    }

    .card-label {
      font-size: .8rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--muted);
      margin-bottom: 6px;
    }

    .card-value {
      font-family: 'Playfair Display', serif;
      font-size: 2rem;
      font-weight: 700;
      color: var(--text);
      line-height: 1;
    }

    .card-sub {
      font-size: .78rem;
      color: var(--muted);
      margin-top: 6px;
    }

    /* ── Table ─────────────────────────────────────────────── */
    .table-wrap {
      background: var(--white);
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
      border: 1.5px solid var(--blush);
      overflow: hidden;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    thead {
      background: linear-gradient(90deg, #fff0f2, #fde8ec);
    }

    thead th {
      padding: 14px 20px;
      text-align: left;
      font-size: .78rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--rose-deep);
    }

    tbody tr {
      border-top: 1px solid var(--petal);
      transition: background .18s;
    }

    tbody tr:hover { background: #fffafb; }

    tbody td {
      padding: 14px 20px;
      font-size: .9rem;
      color: var(--text);
      vertical-align: middle;
    }

    .product-name {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 500;
    }

    .product-emoji {
      width: 34px; height: 34px;
      background: var(--petal);
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem;
      flex-shrink: 0;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 12px;
      border-radius: 99px;
      font-size: .78rem;
      font-weight: 600;
    }

    .badge-green  { background: #e6f7ef; color: #2e8a5a; }
    .badge-amber  { background: #fef3e2; color: #c47a1a; }
    .badge-red    { background: #fce8e8; color: #b94040; }
    .badge-blue   { background: #e8f0fe; color: #3a5fbd; }

    /* ── Two-col layout ────────────────────────────────────── */
    .two-col {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 24px;
      align-items: start;
    }

    /* ── Orders ────────────────────────────────────────────── */
    .order-list {
      background: var(--white);
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
      border: 1.5px solid var(--blush);
      overflow: hidden;
    }

    .order-item {
      display: grid;
      grid-template-columns: 70px 1fr 1fr auto auto;
      gap: 12px;
      align-items: center;
      padding: 14px 20px;
      border-bottom: 1px solid var(--petal);
      font-size: .88rem;
      transition: background .18s;
    }

    .order-item:last-child { border-bottom: none; }
    .order-item:hover { background: #fffafb; }

    .order-item:first-child {
      background: linear-gradient(90deg, #fff0f2, #fde8ec);
      font-size: .75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--rose-deep);
    }

    .order-id { font-weight: 600; color: var(--rose-deep); }

    /* ── Add Product Form ──────────────────────────────────── */
    .form-card {
      background: var(--white);
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
      border: 1.5px solid var(--blush);
      padding: 28px 24px;
    }

    .form-group {
      margin-bottom: 16px;
    }

    label {
      display: block;
      font-size: .82rem;
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: .07em;
      margin-bottom: 7px;
    }

    input[type="text"],
    input[type="number"] {
      width: 100%;
      padding: 11px 15px;
      border: 1.5px solid var(--blush);
      border-radius: var(--radius-sm);
      font-family: 'DM Sans', sans-serif;
      font-size: .92rem;
      color: var(--text);
      background: var(--petal);
      outline: none;
      transition: border-color .2s, box-shadow .2s;
    }

    input[type="text"]:focus,
    input[type="number"]:focus {
      border-color: var(--rose);
      box-shadow: 0 0 0 3px rgba(232,160,170,.20);
      background: var(--white);
    }

    input::placeholder { color: #c4b0b5; }

    .btn-submit {
      width: 100%;
      padding: 13px;
      background: linear-gradient(135deg, var(--rose-deep), var(--rose));
      color: var(--white);
      font-family: 'DM Sans', sans-serif;
      font-size: .95rem;
      font-weight: 600;
      border: none;
      border-radius: var(--radius-sm);
      cursor: pointer;
      box-shadow: 0 4px 16px rgba(200,98,111,.28);
      transition: all .22s ease;
      letter-spacing: .03em;
      margin-top: 6px;
    }

    .btn-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(200,98,111,.36);
    }

    .btn-submit:active { transform: translateY(0); }

    /* ── Success toast ─────────────────────────────────────── */
    .toast {
      display: none;
      align-items: center;
      gap: 10px;
      background: #e6f7ef;
      border: 1px solid #a8dfc3;
      color: #2e6b48;
      font-size: .88rem;
      font-weight: 500;
      padding: 12px 16px;
      border-radius: var(--radius-sm);
      margin-top: 14px;
      animation: fadeIn .3s ease;
    }

    .toast.show { display: flex; }

    @keyframes fadeIn { from { opacity:0; transform:translateY(-6px); } to { opacity:1; transform:translateY(0); } }

    /* ── Footer ────────────────────────────────────────────── */
    footer {
      background: linear-gradient(135deg, #fde8ec 0%, #f5d6da 100%);
      border-top: 1.5px solid var(--blush);
      text-align: center;
      padding: 24px;
    }

    .footer-inner {
      font-size: .83rem;
      color: var(--muted);
      font-weight: 400;
    }

    .footer-inner strong { color: var(--rose-deep); }

    /* ── Responsive ────────────────────────────────────────── */
    @media (max-width: 1024px) {
      .cards-grid { grid-template-columns: repeat(2, 1fr); }
      .two-col { grid-template-columns: 1fr; }
    }

    @media (max-width: 768px) {
      nav { display: none; }
      .hamburger { display: flex; }

      main { padding: 24px 16px 50px; gap: 30px; }
      .cards-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }

      .welcome-banner { padding: 22px 22px; }
      .welcome-text h2 { font-size: 1.2rem; }

      .order-item {
        grid-template-columns: 60px 1fr auto;
        grid-template-rows: auto auto;
        gap: 4px 12px;
        font-size: .82rem;
      }

      .order-item .col-product { grid-column: 2; }
      .order-item .col-amount  { display: none; }
      .order-item .col-status  { grid-column: 3; grid-row: 1/3; align-self: center; }

      thead th:nth-child(3),
      tbody td:nth-child(3) { display: none; }
    }

    @media (max-width: 480px) {
      .cards-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
      .card { padding: 18px 16px; }
      .card-value { font-size: 1.6rem; }
      .header-inner { padding: 0 16px; }
    }

    /* ── Animations on load ────────────────────────────────── */
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .welcome-banner { animation: slideUp .5s ease both; }
    .cards-grid     { animation: slideUp .55s .1s ease both; }
    .table-wrap     { animation: slideUp .55s .2s ease both; }
    .two-col        { animation: slideUp .55s .3s ease both; }
  </style>
</head>
