          <span>Rekha N.</span>
          <span class="col-product">Neem Face Wash</span>
          <span class="col-amount">₹195</span>
          <span class="col-status"><span class="badge badge-red">Cancelled</span></span>
        </div>

      </div>
    </section>

    <!-- Add Product Form -->
    <section>
      <h2 class="section-title">➕ Add Product</h2>
      <div class="form-card">
        <div class="form-group">
          <label for="pName">Product Name</label>
          <input type="text" id="pName" placeholder="e.g. Rose Water Toner" />
        </div>
        <div class="form-group">
          <label for="pPrice">Price (₹)</label>
          <input type="number" id="pPrice" placeholder="e.g. 150" min="0" />
        </div>
        <div class="form-group">
          <label for="pQty">Quantity (units)</label>
          <input type="number" id="pQty" placeholder="e.g. 50" min="0" />
        </div>
        <button class="btn-submit" onclick="handleSubmit()">🌸 Add Product</button>
        <div class="toast" id="toast">✅ Product added successfully!</div>
      </div>
    </section>

  </div>

</main>

